# Поиск фильмов (постеры, описания). Достаточно одного ключа.
# Кинопоиск (неофициальный API, бесплатный ключ): https://kinopoiskapiunofficial.tech
KINOPOISK_API_KEY=
# TMDB (API key v3 или Read Access Token v4): https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# Если заданы оба ключа, можно выбрать явно: kinopoisk или tmdb
MOVIE_PROVIDER=

# Домен для HTTPS (Caddy получит сертификат сам) и адрес сайта для входа через Discord
DOMAIN=reelette.ulya.space
PUBLIC_URL=https://reelette.ulya.space
# Вход через Discord: https://discord.com/developers/applications → New Application → OAuth2.
# В Redirects добавьте PUBLIC_URL + /auth/discord/callback. Без этих ключей остаётся только гостевой вход.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Страна для блока «Где посмотреть» (код ISO, по умолчанию RU)
WATCH_REGION=RU

PORT=3000
