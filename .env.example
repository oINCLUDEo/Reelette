# Поиск фильмов (постеры, описания). Достаточно одного ключа.
# Кинопоиск (неофициальный API, бесплатный ключ): https://kinopoiskapiunofficial.tech
KINOPOISK_API_KEY=
# TMDB (API key v3 или Read Access Token v4): https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# Если заданы оба ключа, можно выбрать явно: kinopoisk или tmdb
MOVIE_PROVIDER=

PORT=3000
